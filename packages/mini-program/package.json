{
  "name": "@meta-track/mini-program",
  "version": "2.1.2",
  "description": "基于 JS 跨平台插件，为小程序（微信原生、Taro、mpx、uniapp等）项目提供【 埋点、行为、性能、异常、请求、资源、路由、曝光、录屏 】监控手段，支持自动采集routeName和pageTitle",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "jsdelivr": "./dist/index.iife.min.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./*": "./*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hevgin/meta-track.git",
    "directory": "packages/mini-program"
  },
  "author": "M-cheng-web <https://github.com/M-cheng-web>",
  "keywords": [
    "埋点",
    "性能",
    "异常",
    "性能采集",
    "异常采集",
    "小程序",
    "微信小程序",
    "Taro",
    "mpx",
    "uni-app",
    "uniapp",
    "前端埋点",
    "前端性能采集"
  ],
  "peerDependencies": {},
  "dependencies": {
    "@meta-track/core": "workspace:*"
  },
  "bugs": {
    "url": "https://github.com/hevgin/meta-track/issues"
  },
  "homepage": "https://github.com/hevgin/meta-track#readme",
  "unpkg": "./dist/index.iife.min.js"
}
